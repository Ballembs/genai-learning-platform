@@ -0,0 +1,396 @@
+// lib/ai/rag.ts
+// RAG (Retrieval-Augmented Generation) pipeline for the chat assistant
+//
+// Architecture:
+//   1. On first query, chunk ALL lesson content (all levels) + term popups
+//   2. Embed all chunks via Voyage AI (cached in memory)
+//   3. For each user query, embed query → find top-K similar chunks
+//   4. Return chunks as context for Claude
+//
+// In production, embeddings would be stored in Supabase with pgvector.
+// For dev, we use in-memory storage (survives until server restart).
+
+import { embedDocuments, embedQuery, cosineSimilarity } from './embeddings';
+import { lessonData } from '@/content/lessons';
+import type { UserLevel } from '@/types';
+
+// ============================================
+// TYPES
+// ============================================
+
+export interface ContentChunk {
+  id: string;
+  text: string;
+  metadata: {
+    lessonId: string;
+    lessonTitle: string;
+    section: string;         // e.g. "main-content", "term-popup", "term-deep-dive-hint"
+    level?: UserLevel;       // which level this content is from
+    termId?: string;         // if this chunk is about a specific term
+    termName?: string;
+  };
+}
+
+interface IndexedChunk extends ContentChunk {
+  embedding: number[];
+}
+
+interface SearchResult {
+  chunk: ContentChunk;
+  score: number;
+}
+
+// ============================================
+// IN-MEMORY INDEX (singleton)
+// ============================================
+
+let indexedChunks: IndexedChunk[] | null = null;
+let indexBuildPromise: Promise<void> | null = null;
+let indexBuildError: Error | null = null;
+
+/**
+ * Lesson metadata mapping
+ */
+const LESSON_META: Record<string, { id: string; title: string }> = {
+  '01-how-ai-works':      { id: 'lesson-01', title: 'How AI Works' },
+  '02-prompt-engineering': { id: 'lesson-02', title: 'Prompt Engineering' },
+  '03-embeddings':         { id: 'lesson-03', title: 'Embeddings & Vector Search' },
+  '04-rag':                { id: 'lesson-04', title: 'RAG' },
+  '05-agents':             { id: 'lesson-05', title: 'Agents & Tools' },
+};
+
+// ============================================
+// CHUNKING
+// ============================================
+
+/**
+ * Split lesson markdown into semantic chunks.
+ *
+ * Strategy: split by ## headers, then split long sections further.
+ * Each chunk includes the header for context.
+ */
+function chunkMarkdown(
+  markdown: string,
+  maxChunkChars: number = 1200
+): string[] {
+  const chunks: string[] = [];
+
+  // Split by ## headers (keep the header with its content)
+  const sections = markdown.split(/(?=^## )/m);
+
+  for (const section of sections) {
+    const trimmed = section.trim();
+    if (!trimmed) continue;
+
+    if (trimmed.length <= maxChunkChars) {
+      chunks.push(trimmed);
+    } else {
+      // Split long sections by double newline (paragraphs)
+      const paragraphs = trimmed.split(/\n\n+/);
+      let current = '';
+
+      // Keep the header with the first chunk
+      const headerMatch = trimmed.match(/^## .+/);
+      const header = headerMatch ? headerMatch[0] : '';
+
+      for (const para of paragraphs) {
+        const candidate = current ? `${current}\n\n${para}` : para;
+        if (candidate.length > maxChunkChars && current) {
+          chunks.push(current);
+          // Start new chunk with header context
+          current = header ? `${header} (continued)\n\n${para}` : para;
+        } else {
+          current = candidate;
+        }
+      }
+      if (current.trim()) {
+        chunks.push(current);
+      }
+    }
+  }
+
+  return chunks;
+}
+
+/**
+ * Extract all content chunks from lesson data.
+ * Includes lesson content at all levels + term popup explanations.
+ */
+function extractAllChunks(): ContentChunk[] {
+  const chunks: ContentChunk[] = [];
+  let chunkIndex = 0;
+
+  for (const [lessonKey, lesson] of Object.entries(lessonData)) {
+    const meta = LESSON_META[lessonKey];
+    if (!meta) continue;
+
+    // --- Lesson content at each level ---
+    const levels: UserLevel[] = ['beginner', 'intermediate', 'advanced'];
+    for (const level of levels) {
+      const content = lesson.content[level];
+      if (!content) continue;
+
+      const textChunks = chunkMarkdown(content);
+      for (const text of textChunks) {
+        // Strip markdown formatting noise for better embedding
+        const cleanText = cleanForEmbedding(text);
+        if (cleanText.length < 30) continue; // Skip tiny chunks
+
+        chunks.push({
+          id: `${meta.id}-${level}-${chunkIndex++}`,
+          text: cleanText,
+          metadata: {
+            lessonId: meta.id,
+            lessonTitle: meta.title,
+            section: 'main-content',
+            level,
+          },
+        });
+      }
+    }
+
+    // --- Term popup explanations ---
+    for (const term of lesson.terms) {
+      for (const level of levels) {
+        const popup = term.popup[level];
+        if (!popup) continue;
+
+        // Combine explanation + example for richer context
+        let text = `Term: ${term.term}\n${popup.explanation}`;
+        if (popup.example) {
+          text += `\nExample: ${popup.example}`;
+        }
+
+        chunks.push({
+          id: `${meta.id}-term-${term.id}-${level}-${chunkIndex++}`,
+          text,
+          metadata: {
+            lessonId: meta.id,
+            lessonTitle: meta.title,
+            section: 'term-popup',
+            level,
+            termId: term.id,
+            termName: term.term,
+          },
+        });
+      }
+    }
+
+    // --- Advanced topics (brief descriptions) ---
+    for (const topic of lesson.advancedTopics) {
+      chunks.push({
+        id: `${meta.id}-adv-${topic.id}-${chunkIndex++}`,
+        text: `Advanced Topic: ${topic.title}\n${topic.description}`,
+        metadata: {
+          lessonId: meta.id,
+          lessonTitle: meta.title,
+          section: 'advanced-topic',
+        },
+      });
+    }
+  }
+
+  console.log(`[RAG] Extracted ${chunks.length} chunks from ${Object.keys(lessonData).length} lessons`);
+  return chunks;
+}
+
+/**
+ * Clean markdown text for better embedding quality.
+ * Removes formatting noise while preserving semantic content.
+ */
+function cleanForEmbedding(text: string): string {
+  return text
+    // Remove mermaid code blocks entirely (not useful for semantic search)
+    .replace(/```mermaid[\s\S]*?```/g, '')
+    // Remove code blocks but keep the code content
+    .replace(/```\w*\n?/g, '')
+    // Remove markdown images
+    .replace(/!\[.*?\]\(.*?\)/g, '')
+    // Remove link formatting but keep text
+    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
+    // Remove [bracket terms] formatting, keep text
+    .replace(/\[([^\]]+)\]/g, '$1')
+    // Remove bold/italic markers
+    .replace(/\*\*([^*]+)\*\*/g, '$1')
+    .replace(/\*([^*]+)\*/g, '$1')
+    // Remove headers markers but keep text
+    .replace(/^#{1,4}\s+/gm, '')
+    // Remove blockquotes
+    .replace(/^>\s*/gm, '')
+    // Collapse whitespace
+    .replace(/\n{3,}/g, '\n\n')
+    .trim();
+}
+
+// ============================================
+// INDEXING (build embeddings)
+// ============================================
+
+/**
+ * Build the in-memory vector index.
+ * Called lazily on first search request.
+ * Thread-safe: concurrent callers share the same promise.
+ */
+async function buildIndex(): Promise<void> {
+  if (indexedChunks !== null) return;     // Already built
+  if (indexBuildPromise) return indexBuildPromise; // Build in progress
+
+  indexBuildPromise = (async () => {
+    try {
+      console.log('[RAG] Building embedding index...');
+      const startTime = Date.now();
+
+      const chunks = extractAllChunks();
+      const texts = chunks.map((c) => c.text);
+
+      // Embed all chunks via Voyage AI
+      const embeddings = await embedDocuments(texts);
+
+      // Combine chunks with embeddings
+      indexedChunks = chunks.map((chunk, i) => ({
+        ...chunk,
+        embedding: embeddings[i],
+      }));
+
+      const elapsed = ((Date.now() - startTime) / 1000).toFixed(1);
+      console.log(`[RAG] Index built: ${indexedChunks.length} chunks embedded in ${elapsed}s`);
+
+      indexBuildError = null;
+    } catch (err) {
+      indexBuildError = err instanceof Error ? err : new Error(String(err));
+      indexedChunks = null;
+      console.error('[RAG] Index build failed:', indexBuildError.message);
+      throw indexBuildError;
+    } finally {
+      indexBuildPromise = null;
+    }
+  })();
+
+  return indexBuildPromise;
+}
+
+// ============================================
+// SEARCH
+// ============================================
+
+export interface RAGSearchOptions {
+  topK?: number;              // Number of results (default: 5)
+  minScore?: number;          // Minimum similarity threshold (default: 0.3)
+  level?: UserLevel;          // Prefer chunks at this level
+  lessonId?: string;          // Boost chunks from this lesson
+}
+
+/**
+ * Search lesson content for chunks relevant to the user's query.
+ *
+ * @param query - The user's question
+ * @param options - Search configuration
+ * @returns Ranked list of relevant content chunks
+ */
+export async function searchContent(
+  query: string,
+  options: RAGSearchOptions = {}
+): Promise<SearchResult[]> {
+  const {
+    topK = 5,
+    minScore = 0.25,
+    level,
+    lessonId,
+  } = options;
+
+  // Ensure index is built
+  await buildIndex();
+
+  if (!indexedChunks || indexedChunks.length === 0) {
+    console.warn('[RAG] No indexed chunks available');
+    return [];
+  }
+
+  // Embed the query
+  const queryEmbedding = await embedQuery(query);
+
+  // Score all chunks
+  let scored = indexedChunks.map((chunk) => {
+    let score = cosineSimilarity(queryEmbedding, chunk.embedding);
+
+    // Boost chunks that match the user's current level
+    if (level && chunk.metadata.level === level) {
+      score *= 1.1; // 10% boost
+    }
+
+    // Boost chunks from the lesson the user is currently viewing
+    if (lessonId && chunk.metadata.lessonId === lessonId) {
+      score *= 1.15; // 15% boost
+    }
+
+    return { chunk, score };
+  });
+
+  // Filter by minimum score, sort descending, take top-K
+  scored = scored
+    .filter((r) => r.score >= minScore)
+    .sort((a, b) => b.score - a.score)
+    .slice(0, topK);
+
+  return scored;
+}
+
+/**
+ * Format search results into a context string for Claude's system prompt.
+ */
+export function formatRAGContext(results: SearchResult[]): string {
+  if (results.length === 0) {
+    return '';
+  }
+
+  const sections = results.map((r, i) => {
+    const meta = r.chunk.metadata;
+    const source = meta.termName
+      ? `${meta.lessonTitle} → ${meta.termName} (${meta.level || 'general'})`
+      : `${meta.lessonTitle} (${meta.level || 'general'})`;
+
+    return `[Source ${i + 1}: ${source}]\n${r.chunk.text}`;
+  });
+
+  return `RELEVANT COURSE CONTENT (use this to answer the user's question):\n\n${sections.join('\n\n---\n\n')}`;
+}
+
+/**
+ * Full RAG pipeline: search + format.
+ * Returns empty string if no relevant content found.
+ */
+export async function getRAGContext(
+  query: string,
+  options: RAGSearchOptions = {}
+): Promise<string> {
+  try {
+    const results = await searchContent(query, options);
+    return formatRAGContext(results);
+  } catch (err) {
+    // RAG is best-effort — if it fails, the chat still works without context
+    console.error('[RAG] Search failed, continuing without context:', err);
+    return '';
+  }
+}
+
+/**
+ * Check if the RAG index is ready (for health checks / UI indicators).
+ */
+export function isIndexReady(): boolean {
+  return indexedChunks !== null && indexedChunks.length > 0;
+}
+
+/**
+ * Get index stats (for debugging / monitoring).
+ */
+export function getIndexStats(): {
+  ready: boolean;
+  chunkCount: number;
+  error: string | null;
+} {
+  return {
+    ready: indexedChunks !== null,
+    chunkCount: indexedChunks?.length ?? 0,
+    error: indexBuildError?.message ?? null,
+  };
+}
