+'use client';
+
+// lib/hooks/usePersistToDb.ts
+// Syncs Zustand store changes to Supabase for authenticated users.
+// Place in providers.tsx so it runs globally.
+
+import { useEffect, useRef } from 'react';
+import { useAuth } from '@/lib/auth';
+import { useUserStore } from '@/lib/store';
+import { saveExploration, updateLessonProgress } from '@/lib/db/supabase';
+import type { Exploration, LessonProgress } from '@/types';
+
+export function usePersistToDb() {
+  const { user, isConfigured } = useAuth();
+  const prevExplorationsRef = useRef<string>('');
+  const prevProgressRef = useRef<string>('');
+  const isInitializedRef = useRef(false);
+
+  useEffect(() => {
+    if (!user || !isConfigured) return;
+
+    // Skip the first render to avoid syncing stale/initial data
+    if (!isInitializedRef.current) {
+      // Capture initial state snapshot
+      const state = useUserStore.getState();
+      prevExplorationsRef.current = JSON.stringify(state.profile?.explorations || []);
+      prevProgressRef.current = JSON.stringify(state.profile?.lessonProgress || []);
+      isInitializedRef.current = true;
+    }
+
+    const unsub = useUserStore.subscribe((state) => {
+      const explorations = state.profile?.explorations || [];
+      const progress = state.profile?.lessonProgress || [];
+
+      // Check for exploration changes
+      const explorationsKey = JSON.stringify(explorations);
+      if (explorationsKey !== prevExplorationsRef.current) {
+        const prevExplorations: Exploration[] = JSON.parse(prevExplorationsRef.current || '[]');
+        prevExplorationsRef.current = explorationsKey;
+
+        // Find new or updated explorations
+        explorations.forEach((exp) => {
+          const prev = prevExplorations.find((p) => p.termId === exp.termId);
+          if (!prev || JSON.stringify(prev) !== JSON.stringify(exp)) {
+            // Save to database (fire and forget)
+            saveExploration(user.id, exp).catch((err) =>
+              console.error('Failed to sync exploration:', err)
+            );
+          }
+        });
+      }
+
+      // Check for lesson progress changes
+      const progressKey = JSON.stringify(progress);
+      if (progressKey !== prevProgressRef.current) {
+        const prevProgress: LessonProgress[] = JSON.parse(prevProgressRef.current || '[]');
+        prevProgressRef.current = progressKey;
+
+        progress.forEach((p) => {
+          const prev = prevProgress.find((pp) => pp.lessonId === p.lessonId);
+          if (!prev || JSON.stringify(prev) !== JSON.stringify(p)) {
+            updateLessonProgress(user.id, p.lessonId, p).catch((err) =>
+              console.error('Failed to sync progress:', err)
+            );
+          }
+        });
+      }
+    });
+
+    return () => {
+      unsub();
+      isInitializedRef.current = false;
+    };
+  }, [user, isConfigured]);
+}
