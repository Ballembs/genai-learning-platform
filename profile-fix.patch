+// lib/ai/embeddings.ts
+// Voyage AI embeddings wrapper for RAG
+// Docs: https://docs.voyageai.com/reference/embeddings-api
+
+/**
+ * Embedding result for a single text
+ */
+export interface EmbeddingResult {
+  embedding: number[];
+  index: number;
+}
+
+/**
+ * Voyage AI embedding response
+ */
+interface VoyageEmbeddingResponse {
+  object: string;
+  data: EmbeddingResult[];
+  model: string;
+  usage: {
+    total_tokens: number;
+  };
+}
+
+/**
+ * Configuration for the embeddings client
+ */
+interface EmbeddingsConfig {
+  model: string;
+  batchSize: number;
+}
+
+const DEFAULT_CONFIG: EmbeddingsConfig = {
+  model: 'voyage-3-lite',       // Fast + cheap, good enough for course content
+  batchSize: 64,                // Voyage allows up to 128 texts per request
+};
+
+/**
+ * Get embedding(s) from Voyage AI.
+ *
+ * @param texts - Array of texts to embed
+ * @param inputType - "document" for stored content, "query" for search queries
+ * @returns Array of embedding vectors
+ */
+export async function getEmbeddings(
+  texts: string[],
+  inputType: 'document' | 'query' = 'document',
+  config: Partial<EmbeddingsConfig> = {}
+): Promise<number[][]> {
+  const apiKey = process.env.VOYAGE_API_KEY;
+  if (!apiKey) {
+    throw new Error(
+      'VOYAGE_API_KEY environment variable is not set. ' +
+      'Get one at https://dash.voyageai.com/ and add to .env.local'
+    );
+  }
+
+  const { model, batchSize } = { ...DEFAULT_CONFIG, ...config };
+  const allEmbeddings: number[][] = [];
+
+  // Process in batches
+  for (let i = 0; i < texts.length; i += batchSize) {
+    const batch = texts.slice(i, i + batchSize);
+
+    const response = await fetch('https://api.voyageai.com/v1/embeddings', {
+      method: 'POST',
+      headers: {
+        'Content-Type': 'application/json',
+        'Authorization': `Bearer ${apiKey}`,
+      },
+      body: JSON.stringify({
+        model,
+        input: batch,
+        input_type: inputType,
+      }),
+    });
+
+    if (!response.ok) {
+      const errorBody = await response.text().catch(() => 'Unknown error');
+      throw new Error(
+        `Voyage AI API error (${response.status}): ${errorBody}`
+      );
+    }
+
+    const data: VoyageEmbeddingResponse = await response.json();
+
+    // Sort by index to maintain order, then extract embeddings
+    const sorted = data.data.sort((a, b) => a.index - b.index);
+    allEmbeddings.push(...sorted.map((d) => d.embedding));
+  }
+
+  return allEmbeddings;
+}
+
+/**
+ * Embed a single query string.
+ * Uses input_type="query" for asymmetric search (query vs document).
+ */
+export async function embedQuery(text: string): Promise<number[]> {
+  const results = await getEmbeddings([text], 'query');
+  return results[0];
+}
+
+/**
+ * Embed an array of document strings.
+ * Uses input_type="document" for the stored/indexed side.
+ */
+export async function embedDocuments(texts: string[]): Promise<number[][]> {
+  return getEmbeddings(texts, 'document');
+}
+
+/**
+ * Cosine similarity between two vectors.
+ * Voyage embeddings are already normalized, so dot product = cosine similarity.
+ */
+export function cosineSimilarity(a: number[], b: number[]): number {
+  if (a.length !== b.length) {
+    throw new Error(`Vector dimension mismatch: ${a.length} vs ${b.length}`);
+  }
+  let dot = 0;
+  for (let i = 0; i < a.length; i++) {
+    dot += a[i] * b[i];
+  }
+  return dot;
+}
